{
  "name": "webgpu-trees",
  "private": true,
  "version": "0.0.0",
  "description": "Trees for three.js on WebGPU, written in TSL: grown to measured sizes, drawn stylized or real, with a lab to set them in.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --open /lab/",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs test/*.test.ts"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  }
}
